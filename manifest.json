{
    "manifest_version": 3,
    "name": "Page Performance Monitor",
    "version": "1.0",
    "description": "Monitor webpage performance metrics like load time and slow scripts",
    "permissions": ["scripting", "activeTab", "storage"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Page Performance Monitor"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_start"
      }
    ],
    "background": {
      "service_worker": "background.js"
    },
    "host_permissions": ["<all_urls>"]
  }
  